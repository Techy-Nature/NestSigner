<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <!-- Keystore -->
        <LinearLayout style="@style/NestSigner.Card">

            <TextView style="@style/NestSigner.CardTitle" android:text="@string/section_keystore" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_file_name" />
            <EditText
                android:id="@+id/file_name"
                style="@style/NestSigner.Field"
                android:inputType="text"
                android:text="@string/default_file_name"
                android:importantForAutofill="no" />
            <TextView style="@style/NestSigner.Helper" android:text="@string/helper_file_name" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_store_pw" />
            <EditText
                android:id="@+id/store_pw"
                style="@style/NestSigner.Field"
                android:hint="@string/hint_min_chars"
                android:inputType="textPassword"
                android:importantForAutofill="no" />
            <EditText
                android:id="@+id/store_pw2"
                style="@style/NestSigner.Field"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_confirm"
                android:inputType="textPassword"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Key -->
        <LinearLayout style="@style/NestSigner.Card">

            <TextView style="@style/NestSigner.CardTitle" android:text="@string/section_key" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_alias" />
            <EditText
                android:id="@+id/alias"
                style="@style/NestSigner.Field"
                android:inputType="text"
                android:text="@string/default_alias"
                android:importantForAutofill="no" />
            <TextView style="@style/NestSigner.Helper" android:text="@string/helper_alias" />

            <CheckBox
                android:id="@+id/same_pw"
                style="@style/NestSigner.Check"
                android:checked="true"
                android:text="@string/same_pw" />

            <LinearLayout
                android:id="@+id/key_pw_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/NestSigner.Label" android:text="@string/label_key_pw" />
                <EditText
                    android:id="@+id/key_pw"
                    style="@style/NestSigner.Field"
                    android:hint="@string/hint_min_chars"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />
                <EditText
                    android:id="@+id/key_pw2"
                    style="@style/NestSigner.Field"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_confirm"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/show_pw"
                style="@style/NestSigner.Check"
                android:text="@string/show_pw" />
        </LinearLayout>

        <!-- Certificate -->
        <LinearLayout style="@style/NestSigner.Card">

            <TextView style="@style/NestSigner.CardTitle" android:text="@string/section_cert" />
            <TextView style="@style/NestSigner.Helper" android:layout_marginTop="0dp"
                android:text="@string/helper_cert" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_cn" />
            <EditText android:id="@+id/cn" style="@style/NestSigner.Field"
                android:inputType="textPersonName|textCapWords" android:importantForAutofill="no" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_ou" />
            <EditText android:id="@+id/ou" style="@style/NestSigner.Field"
                android:hint="@string/hint_optional" android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_org" />
            <EditText android:id="@+id/org" style="@style/NestSigner.Field"
                android:hint="@string/hint_optional" android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <TextView style="@style/NestSigner.Label" android:text="@string/label_city" />
            <EditText android:id="@+id/city" style="@style/NestSigner.Field"
                android:hint="@string/hint_optional" android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="2"
                    android:orientation="vertical">
                    <TextView style="@style/NestSigner.Label" android:text="@string/label_state" />
                    <EditText android:id="@+id/state" style="@style/NestSigner.Field"
                        android:hint="@string/hint_optional" android:inputType="textCapWords"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/NestSigner.Label" android:text="@string/label_country" />
                    <EditText android:id="@+id/country" style="@style/NestSigner.Field"
                        android:hint="@string/hint_country" android:inputType="textCapCharacters"
                        android:maxLength="2" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/NestSigner.Label" android:text="@string/label_years" />
            <EditText android:id="@+id/years" style="@style/NestSigner.Field"
                android:inputType="number" android:maxLength="3"
                android:text="@string/default_years" android:importantForAutofill="no" />
            <TextView style="@style/NestSigner.Helper" android:text="@string/helper_years" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/error_bg"
            android:padding="14dp"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/create_button"
            style="@style/NestSigner.Button.Primary"
            android:text="@string/create" />

        <!-- Result -->
        <LinearLayout
            android:id="@+id/result_card"
            style="@style/NestSigner.Card"
            android:background="@drawable/result_bg"
            android:visibility="gone">

            <TextView style="@style/NestSigner.CardTitle"
                android:textColor="@color/accent"
                android:text="@string/saved_title" />

            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView style="@style/NestSigner.Helper"
                android:layout_marginTop="12dp"
                android:text="@string/backup_warning" />

            <Button
                android:id="@+id/copy_button"
                style="@style/NestSigner.Button.Secondary"
                android:layout_marginTop="16dp"
                android:text="@string/copy_details" />

            <Button
                android:id="@+id/again_button"
                style="@style/NestSigner.Button.Secondary"
                android:layout_marginTop="8dp"
                android:text="@string/make_another" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/footer"
            android:textColor="@color/text3"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
