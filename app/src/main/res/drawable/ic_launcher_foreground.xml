<?xml version="1.0" encoding="utf-8"?>
<!-- NestSigner icon: a parchment scroll with a quill, on a 108dp adaptive-icon canvas
     (the launcher's safe zone is the middle 66dp, roughly 21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="-1"
        android:translateY="2">

    <!-- Scroll sheet -->
    <path
        android:fillColor="#E8DCBC"
        android:pathData="M31,34 L65,34 L65,76 L31,76 Z" />

    <!-- Top roll -->
    <path
        android:fillColor="#D4C49C"
        android:pathData="M31,29 L65,29 A4.5,4.5 0 0,1 65,38 L31,38 A4.5,4.5 0 0,1 31,29 Z" />
    <path
        android:fillColor="#B7A57A"
        android:pathData="M26.5,33.5 A4.5,4.5 0 1,1 35.5,33.5 A4.5,4.5 0 1,1 26.5,33.5 Z" />

    <!-- Bottom roll -->
    <path
        android:fillColor="#D4C49C"
        android:pathData="M31,72 L65,72 A4.5,4.5 0 0,1 65,81 L31,81 A4.5,4.5 0 0,1 31,72 Z" />
    <path
        android:fillColor="#B7A57A"
        android:pathData="M60.5,76.5 A4.5,4.5 0 1,1 69.5,76.5 A4.5,4.5 0 1,1 60.5,76.5 Z" />

    <!-- Writing lines -->
    <path
        android:strokeColor="#8E7E5A"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M37,45 L58,45 M37,51 L58,51 M37,57 L52,57 M37,63 L48,63" />

    <!-- Quill feather -->
    <path
        android:fillColor="#5CC39A"
        android:pathData="M57,64 Q58,38 84,22 Q80,47 57,64 Z" />

    <!-- Feather vein -->
    <path
        android:strokeColor="#2F7A5C"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M57,64 Q69,44 84,22" />

    <!-- Shaft and nib -->
    <path
        android:strokeColor="#E6ECE9"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M58,62.5 L51,73" />
    <path
        android:fillColor="#2B2F33"
        android:pathData="M51.8,71.6 L49.2,75.6 L48.6,77 L50,76 L52.6,72.2 Z" />
    </group>
</vector>
